# Server-side only. Never use VITE_ prefixes for private credentials.
# Add actual values only in Vercel Project Settings -> Environment Variables.
CLIENT_ID=
CLIENT_SECRET=

# Optional aliases also accepted by the server-side adapter.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Optional app metadata for future integrations.
APP_URL=http://localhost:5173

# Auth0 SPA configuration (safe for VITE_ because these are public identifiers)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://shopline-api

# Server-side Auth0 API configuration. Keep these values only in Vercel Environment Variables.
# AUTH0_DOMAIN must be the tenant domain without https://, e.g. your-tenant.us.auth0.com
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://shopline-api
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
